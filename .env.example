# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.

# --- LLM (API tương thích OpenAI: vLLM local, OpenRouter, ...) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen2.5-14b
# LLM_MAX_TOKENS=4096

# --- Agent (tuỳ chọn; giá trị dưới đây là mặc định) ---
# AGENT_MAX_ATTEMPTS=4       # 1 lần sinh + tối đa 3 lần sửa code
# AGENT_SAMPLES=4            # số lần sinh độc lập tối đa cho mỗi câu (luân phiên pandas, SQL)
# AGENT_MIN_AGREE=2          # số lần sinh phải trùng đáp án mới trả lời, không thì abstain
# AGENT_SAMPLE_TEMPERATURE=0.6
# AGENT_LLM_REVIEW=false
